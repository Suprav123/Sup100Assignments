<h1>Task 3</h1>

<h2>Registration Form</h2>
<form>
    <table>
        <tr>
            <td>First Name</td>
            <td><input type="text" name="firstname"></td>
        </tr>
        <tr>
            <td>Last Name</td>
            <td><input type="text" name="lastname"></td>
        </tr>
        <tr>
            <td>Email</td>
            <td><input type="email" name="email"></td>
        </tr>
        <tr>
            <td>Password</td>
            <td><input type="password" name="password"></td>
        </tr>
        <tr>
            <td>Re-enter Password</td>
            <td><input type="password" name="repassword"></td>
        </tr>
        <tr>
            <td>Gender:</td>
            <td>
                <input type="radio" name="gender"> Male<br>
                <input type="radio" name="gender"> Female
            </td>
        <tr>
            <td>Age:</td>
            <td><input type="number" name="age"></td>
        </tr>
        <tr>
            <td>Phone number:</td>
            <td><input type="tel" name="phone number"></td>
        </tr>
        <tr>
            <td>Address:</td>
            <td><textarea name="address" rows="5"></textarea></td>
        </tr>
        <tr>
            <td>State:</td>
            <td><input type="text" name="state"></td>
        </tr>
        <tr>
            <td>Country:</td>
            <td><select name="country">
                <option>Choose your country</option>
                <option>Nepal</option>
                <option>India</option>
                <option>Japan</option>
                <option>USA</option>
            </select></td>
        </tr>
        <tr>
            <td>Languages known:</td>
            <td>
                <input type="checkbox" name="lang" value="English">English
                <input type="checkbox" name="lang" value="Kannada">Kannada
                <input type="checkbox" name="lang" value="Hindi">Hindi
                <input type="checkbox" name="lang" value="Telugu">Telugu
            </td>
        </tr>
        <tr>
            <td colspan="2">
                <input type="checkbox"> Hereby I declare all the given details are true
            </td>
        </tr>
        <tr>
            <td colspan="2" class="center">
                log into <a href="https://www.acharya.ac.in/" target="_blank">Acharya</a> website
            </td>
        </tr>
        <tr>
            <td colspan="2" class="center">
                <input type="submit" value="Register">
            </td>
        </tr>


